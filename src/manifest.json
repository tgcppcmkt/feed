{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.2.9",
  "description": "個別フィードのフォルダ変更・削除・個別更新に対応したMyFeed（最古代表・全件表示・国内+海外News・6並列更新対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
